{
  "name": "@ralphtq/rdf-n3-quads",
  "version": "0.2.0",
  "description": "Port-agnostic TypeScript wrapper around N3.js + Comunica + rdf-validate-shacl for RDF quad-store, SPARQL, and SHACL validation. Companion to the ralphtq/elm-rdf Elm package.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "rdf",
    "sparql",
    "shacl",
    "n3",
    "comunica",
    "quad-store",
    "turtle",
    "jsonld"
  ],
  "author": "Ralph <ralph@interoptx.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ralphtq/rdf-n3-quads.git"
  },
  "peerDependencies": {
    "@comunica/query-sparql": "^5.0.0",
    "jsonld": "^9.0.0",
    "jszip": "^3.0.0",
    "n3": "^2.0.0",
    "rdf-validate-shacl": "^0.5.0",
    "sparqljs": "^3.0.0"
  },
  "devDependencies": {
    "@comunica/query-sparql": "^5.1.3",
    "@types/n3": "^1.26.0",
    "@types/node": "^25.3.0",
    "@types/sparqljs": "^3.1.10",
    "jsonld": "^9.0.0",
    "jszip": "^3.10.1",
    "n3": "^2.0.1",
    "rdf-validate-shacl": "^0.5.10",
    "sparqljs": "^3.7.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
